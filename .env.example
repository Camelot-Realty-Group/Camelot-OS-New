# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# AI Chat Backend (OpenAI-compatible API — works with OpenAI, Anthropic via proxy, OpenRouter, local LLMs, etc.)
# If not set, Scout AI chat will show a "Configure AI in Settings" message.
# All other features (NYC data, scoring, pipeline, outreach) work without AI.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o
VITE_AI_MODEL=gpt-4o

# Contact enrichment (server-side only; never prefix secrets with VITE_)
APOLLO_API_KEY=your-apollo-api-key
PROSPEO_API_KEY=your-prospeo-api-key

# Scout + HubSpot Integrations
# Server-side values should be configured in Render environment variables.
SCOUT_API_URL=https://your-scout-api.example.com
SCOUT_API_KEY=your-scout-api-key
SCOUT_WORKSPACE_ID=your-scout-workspace-id
HUBSPOT_API_KEY=your-hubspot-private-app-token
# Preferred server-side HubSpot private app token. Keep this only in Render/server env vars.
HUBSPOT_PRIVATE_APP_TOKEN=your-hubspot-private-app-token
# Optional HubSpot portal id for building direct CRM links after sync.
HUBSPOT_PORTAL_ID=your-hubspot-portal-id
# Pipeline/deal sync is enabled when HUBSPOT_DEAL_STAGE_ID is set.
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_ID=your-hubspot-deal-stage-id
# Optional: set true to create HubSpot follow-up tasks from bot activity and CTA scenarios.
HUBSPOT_CREATE_TASKS=false
# Optional: set true only in controlled setup sessions; otherwise HubSpot rollout scripts are dry-run.
HUBSPOT_ROLLOUT_APPLY=false

# Spire MDS (Camelot's own property-management/accounting backend — Resident
# Management, AP, GL, Work Orders). Server-side only; never expose to the
# browser. Set the real values only in Render/server env vars.
SPIRE_MDS_API_KEY=your-spire-mds-api-key
SPIRE_MDS_CLIENT_SECRET=your-spire-mds-client-secret

# Disable server integration attempts only for true static hosting without server.js.
VITE_DISABLE_SERVER_INTEGRATIONS=false

# Google Maps (optional, for embeds)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# RealtyMX (optional, for Sentinel live rental inventory / DOM / unit mix)
